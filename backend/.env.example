# =================================================================
# E-COMMERCE BACKEND ENVIRONMENT CONFIGURATION
# =================================================================

# Server Port
PORT=5000

# Environment: development | production | test
NODE_ENV=development

# MongoDB Connection String
# For Local: mongodb://localhost:27017/ecommerce
# For Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/ecommerce?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/ecommerce

# JWT Authentication
# Secret key used to sign JSON Web Tokens (use a strong random 64-char string in production)
JWT_SECRET=super_secret_jwt_key_replace_with_secure_random_string_in_production_2026
JWT_EXPIRE=30d

# Frontend Application URL (for CORS)
CLIENT_URL=http://localhost:3000

# Stripe Payment Processing (optional for demo/testing mode)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here

# Email Notification Configuration (Nodemailer - optional)
EMAIL_SERVICE=gmail
EMAIL_USERNAME=your_email@gmail.com
EMAIL_PASSWORD=your_email_app_password
EMAIL_FROM=no-reply@ecommerce.com

# Logging Level: error | warn | info | http | verbose | debug | silly
LOG_LEVEL=info
